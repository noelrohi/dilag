{
  "$schema": "https://v2-10-5.turborepo.dev/schema.json",
  "globalEnv": [
    "VITE_DEV_SERVER_URL",
    "VITE_DEV_SERVER_HOST",
    "VITE_PORT",
    "ELECTRON_REMOTE_DEBUGGING_PORT",
    "DILAG_API_URL",
    "DILAG_BRAND_TOKENS",
    "DILAG_DOMAIN_HINT",
    "DILAG_REFERENCE_URLS",
    "APPLE_SIGNING_IDENTITY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": []
    },
    "lint": {
      "dependsOn": [],
      "inputs": ["src/**", "electron/**", "eslint.config.*", "package.json"]
    },
    "clean": {
      "cache": false
    }
  }
}
