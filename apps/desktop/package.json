{
  "name": "@dilag/desktop",
  "private": true,
  "version": "0.6.6",
  "description": "AI-powered design studio for mobile and web app prototypes.",
  "author": "Noel Garcia",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "bun scripts/dev-electron.mjs",
    "dev:electron": "bun scripts/dev-electron.mjs",
    "dev:renderer": "vite",
    "build": "tsc && vite build && tsdown",
    "build:electron": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "dist": "bun run build && electron-builder",
    "smoke:electron": "bun run build && bun scripts/smoke-electron.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:prompt-flow": "vitest run src/hooks/use-sessions.test.ts -t \"project chat and sends the first prompt\"",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "release": "bumpp",
    "check:stale": "node scripts/check-stale-tauri.mjs"
  },
  "build": {
    "appId": "com.rohi.dilag",
    "productName": "Dilag",
    "copyright": "Copyright © 2026 Noel Garcia",
    "directories": {
      "output": "release/electron"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icons",
        "to": "icons"
      },
      {
        "from": "resources/design-assets",
        "to": "design-assets"
      }
    ],
    "mac": {
      "icon": "resources/icons/icon.icns",
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "10.15",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icons/icon.ico"
    },
    "linux": {
      "icon": "resources/icons/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "noelrohi",
        "repo": "dilag"
      }
    ]
  },
  "dependencies": {
    "@dilag/desktop-bridge": "workspace:*",
    "@dilag/ui": "workspace:*",
    "@earendil-works/pi-coding-agent": "^0.75.3",
    "@pierre/diffs": "^1.0.4",
    "@tabler/icons-react": "catalog:",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-router": "^1.141.2",
    "@xyflow/react": "^12.10.0",
    "ai": "^5.0.113",
    "clsx": "catalog:",
    "dayjs": "^1.11.19",
    "diff": "^8.0.2",
    "electron-updater": "^6.8.3",
    "howler": "^2.2.4",
    "html2canvas-pro": "^1.6.4",
    "immer": "^11.0.1",
    "jszip": "^3.10.1",
    "motion": "^12.23.26",
    "nanoid": "^5.1.6",
    "nuqs": "^2.8.6",
    "radix-ui": "catalog:",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "catalog:",
    "sonner": "catalog:",
    "streamdown": "^1.6.10",
    "tailwind-merge": "catalog:",
    "tailwindcss": "^4.1.18",
    "tokenlens": "^1.3.1",
    "typebox": "^1.1.38",
    "use-stick-to-bottom": "^1.1.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.11",
    "@tanstack/router-plugin": "^1.141.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/howler": "^2.2.12",
    "@types/node": "^25.0.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/ui": "^4.0.16",
    "bumpp": "^10.3.2",
    "electron": "41.2.2",
    "electron-builder": "^26.8.1",
    "jsdom": "^27.3.0",
    "react-grab": "^0.1.37",
    "tsdown": "^0.21.9",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vite": "^7.0.4",
    "vite-console-forward-plugin": "^2.0.1",
    "vitest": "^4.0.16"
  }
}
