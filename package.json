{
  "name": "dilag",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@eslint/js": "^9",
      "@tabler/icons-react": "^3.44.0",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "cmdk": "^1.1.1",
      "embla-carousel-react": "^8.6.0",
      "eslint": "^9",
      "eslint-plugin-react-hooks": "^6",
      "globals": "^16",
      "radix-ui": "^1.4.3",
      "react-resizable-panels": "2.0.23",
      "sonner": "^2.0.7",
      "tailwind-merge": "^3.4.0",
      "tw-animate-css": "^1.4.0",
      "typescript": "^5",
      "typescript-eslint": "^8"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:desktop": "turbo dev --filter=@dilag/desktop",
    "dev:web": "turbo dev --filter=@dilag/web",
    "electron:dev": "bun run --cwd apps/desktop dev",
    "electron:dist": "bun run --cwd apps/desktop dist",
    "build": "turbo build",
    "build:desktop": "turbo build --filter=@dilag/desktop",
    "build:web": "turbo build --filter=@dilag/web",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "test:prompt-flow": "bun run --cwd apps/desktop test:prompt-flow",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.7.3"
  },
  "packageManager": "bun@1.2.14"
}
